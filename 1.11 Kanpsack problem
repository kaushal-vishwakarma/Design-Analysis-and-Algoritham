#include <stdio.h>
#include <stdlib.h>

// Function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n, W;

    // Read the number of items
    if (scanf("%d", &n) != 1) return 0;

    int *values = (int *)malloc(n * sizeof(int));
    int *weights = (int *)malloc(n * sizeof(int));

    // Read the values of the items
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }

    // Read the weights of the items
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }

    // Read the capacity of the knapsack
    if (scanf("%d", &W) != 1) return 0;

    // dp[w] will store the maximum value that can be attained with capacity w
    int *dp = (int *)calloc(W + 1, sizeof(int));

    // Build the dp array in a bottom-up manner
    for (int i = 0; i < n; i++) {
        // Traverse backwards to prevent using the same item multiple times
        for (int w = W; w >= weights[i]; w--) {
            dp[w] = max(dp[w], dp[w - weights[i]] + values[i]);
        }
    }

    // The maximum value is stored at dp[W]
    printf("%d\n", dp[W]);

    // Free allocated memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}
