#include <stdio.h>
#include <stdlib.h>
#include <limits.h>



#define INF 9999

// Structure to represent a graph edge
typedef struct {
    int u, v, weight;
} Edge;

// Compare function for qsort to sort edges by weight.
// Breaks ties following row-wise order in the upper triangular matrix (u first, then v).
int compareEdges(const void *a, const void *b) {
    Edge *edgeA = (Edge *)a;
    Edge *edgeB = (Edge *)b;
    if (edgeA->weight != edgeB->weight) {
        return edgeA->weight - edgeB->weight;
    }
    if (edgeA->u != edgeB->u) {
        return edgeA->u - edgeB->u;
    }
    return edgeA->v - edgeB->v;
}

// Find function for Disjoint Set Union (DSU) with path compression
int findSet(int *parent, int i) {
    if (parent[i] == i)
        return i;
    return parent[i] = findSet(parent, parent[i]);
}

void kruskalMST(int **cost, int V) {
    int maxEdges = (V * (V - 1)) / 2;
    Edge *edges = (Edge *)malloc(maxEdges * sizeof(Edge));
    int edgeCount = 0;

    // 1. Extract edges from the upper triangular matrix to avoid duplicates
    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            if (cost[i][j] != INF) {
                edges[edgeCount].u = i;
                edges[edgeCount].v = j;
                edges[edgeCount].weight = cost[i][j];
                edgeCount++;
            }
        }
    }

    // 2. Sort edges according to weight and row-wise presentation constraints
    qsort(edges, edgeCount, sizeof(Edge), compareEdges);

    // 3. Allocate and initialize the DSU parent array
    int *parent = (int *)malloc(V * sizeof(int));
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int mstEdges = 0;
    int totalCost = 0;

    // 4. Construct the tree by iterating through the sorted edges
    for (int i = 0; i < edgeCount && mstEdges < V - 1; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int w = edges[i].weight;

        int rootU = findSet(parent, u);
        int rootV = findSet(parent, v);

        // If including this edge does not introduce a cycle
        if (rootU != rootV) {
            printf("Edge %d:(%d, %d) cost:%d\n", mstEdges, u, v, w);
            totalCost += w;
            mstEdges++;
            
            // Union operations: join the tree components
            parent[rootU] = rootV;
        }
    }

    // 5. Output total minimal cost structure
    printf("Minimum cost= %d\n", totalCost);

    // Free local arrays
    free(parent);
    free(edges);
}


int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
