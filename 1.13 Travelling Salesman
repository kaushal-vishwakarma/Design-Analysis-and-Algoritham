#include <stdio.h>
#include <limits.h>

#define MAXN 16
#define INF 1e9

int n;
int cost[MAXN][MAXN];
int dp[1 << MAXN][MAXN];

int min(int a, int b) {
    return (a < b) ? a : b;
}

int tsp() {
    int total_states = 1 << n;

    // Initialize DP array with infinity
    for (int mask = 0; mask < total_states; mask++) {
        for (int i = 0; i < n; i++) {
            dp[mask][i] = INF;
        }
    }

    // Base case: Start at city 0
    dp[1][0] = 0;

    // Iterate through all subset bitmasks
    for (int mask = 1; mask < total_states; mask++) {
        for (int u = 0; u < n; u++) {
            if (dp[mask][u] == INF) continue;

            // Try to visit an unvisited city 'v'
            for (int v = 0; v < n; v++) {
                if (!(mask & (1 << v)) && cost[u][v] != -1) {
                    int next_mask = mask | (1 << v);
                    dp[next_mask][v] = min(dp[next_mask][v], dp[mask][u] + cost[u][v]);
                }
            }
        }
    }

    // Find the minimum cost to visit all cities and return to city 0
    int full_mask = (1 << n) - 1;
    int ans = INF;

    for (int u = 1; u < n; u++) {
        if (dp[full_mask][u] != INF && cost[u][0] != -1) {
            ans = min(ans, dp[full_mask][u] + cost[u][0]);
        }
    }

    return (ans >= INF) ? -1 : ans;
}

int main() {
    if (scanf("%d", &n) != 1) return 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    printf("%d", tsp());

    return 0;
}
